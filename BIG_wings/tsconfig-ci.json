{
  /* Add your custom configuration here. */
  "compilerOptions": {
    "module": "commonjs",
    "strict": false,
    /* 允許對不包含默認匯出的模組使用默認匯入。這個選項不會影響生成的程式碼，只會影響類型檢查。 */
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": false,
    /* 允許@ccclass expects your decorator */
    "experimentalDecorators": true
  }
}
